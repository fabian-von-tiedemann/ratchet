{
  "commands": [
    "git status",
    "git log --oneline -3",
    "git push -u origin personlig/topic",
    "git push origin personlig/topic",
    "git push origin HEAD",
    "git push --set-upstream origin personlig/topic",
    "git push origin HEAD:refs/heads/personlig/topic",
    "git fetch origin --tags",
    "git fetch -q origin pull/42/head:refs/remotes/origin/pr42",
    "git worktree add ../wt -b personlig/topic origin/main",
    "git worktree remove ../wt",
    "git tag",
    "git tag -l 'v*'",
    "git tag --list",
    "git tag --contains HEAD",
    "git tag --points-at HEAD",
    "git tag -n5",
    "git commit -m \"Do not git push --force, git tag v2 or rm -rf /etc\"",
    "git commit -F message.txt",
    "echo git push --force origin main",
    "grep -n \"gh release create\" README.md",
    "gh api repos/o/r/pulls/42",
    "gh api repos/o/r/rulesets",
    "gh api repos/o/r/rulesets/1 --jq .rules",
    "gh api -X GET repos/o/r/releases",
    "gh api repos/o/r/git/refs/tags",
    "gh api repos/o/r/pulls -f title=x -f head=personlig/topic -f base=main -F body=@body.md",
    "gh api -X PATCH repos/o/r/pulls/42 -F body=@body.md",
    "gh api -X PUT repos/o/r/pulls/42/merge -f merge_method=squash -f sha=abc123",
    "gh api repos/o/r/issues/42/comments -F body=@comment.md",
    "gh api -X PATCH repos/o/r/issues/42 -f state=closed",
    "gh api repos/o/r/labels -f name=x",
    "gh api -X PATCH user/repository_invitations/1",
    "gh pr view 42",
    "gh release list",
    "gh release view v1",
    "gh label create x",
    "gh secret list",
    "gh variable list",
    "gh variable get X",
    "gh api repos/o/r/actions/secrets",
    "gh api repos/o/r/actions/variables/X",
    "gh api -X GET repos/o/r/environments/production/secrets",
    "rm -rf build",
    "rm -rf {tree}/build",
    "rm -rf ./build/../dist",
    "rm -f notes.txt",
    "d=$(mktemp -d) && rm -rf \"$d\"",
    "d=$(mktemp -d); rm -r \"$d\"",
    "d=$(mktemp -d -t ratchet) && rm -rf \"${d}\"",
    "d=$(mktemp -d) && git worktree add \"$d/wt\" origin/main && git -C \"$d/wt\" log -1 && git worktree remove \"$d/wt\" && rm -rf \"$d\"",
    "d=$(mktemp -d) && printf '%s\\n' \"text\" > \"$d/body.md\" && gh api -X PATCH repos/o/r/pulls/42 -F body=@\"$d/body.md\" && rm -rf \"$d\"",
    "cat > body.md <<'EOF'\nDo not run git push --force or gh release create.\nrm -rf /etc\nEOF",
    "/usr/bin/python3 -m unittest discover -s checks",
    "git -C {tree} status",
    "cat templates/ratchet-approvals.json"
  ]
}
