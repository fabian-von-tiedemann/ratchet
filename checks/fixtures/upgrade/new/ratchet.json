{
  "version": "9.9",
  "start": [
    "ratchet.keep"
  ],
  "principles": [
    {
      "key": "principle.one",
      "title": "One",
      "text": "One principle over every rule."
    }
  ],
  "parts": [
    {
      "id": "one",
      "file": "RATCHET.md",
      "title": "One"
    }
  ],
  "rules": [
    {
      "key": "ratchet.keep",
      "part": "one",
      "principle": "principle.one",
      "status": "core",
      "enforcement": "enforced",
      "rule": "Every change has a test.",
      "ratchet": "Check: the tests run on every PR",
      "source": ""
    },
    {
      "key": "ratchet.reworded",
      "part": "one",
      "principle": "principle.one",
      "status": "experimental",
      "since": "9.8",
      "enforcement": "text-only",
      "rule": "Prefer the simplest solution that works.",
      "ratchet": "Text only: simplicity is a judgment",
      "source": ""
    },
    {
      "key": "ratchet.now-checked",
      "part": "one",
      "principle": "principle.one",
      "status": "experimental",
      "since": "9.8",
      "enforcement": "enforced",
      "rule": "Name every decision.",
      "ratchet": "Check: a lint of the decision file's name",
      "source": ""
    },
    {
      "key": "ratchet.now-text",
      "part": "one",
      "principle": "principle.one",
      "status": "experimental",
      "since": "9.8",
      "enforcement": "text-only",
      "rule": "Every release has a changelog entry.",
      "ratchet": "Text only: a lint cannot tell whether an entry is complete",
      "source": ""
    },
    {
      "key": "ratchet.new-ratchet",
      "part": "one",
      "principle": "principle.one",
      "status": "experimental",
      "since": "9.8",
      "enforcement": "enforced",
      "rule": "No secrets in the repo.",
      "ratchet": "Check: a secret scan in every PR and every night",
      "source": "someone/somewhere `a-skill`"
    },
    {
      "key": "ratchet.left-out",
      "part": "one",
      "principle": "principle.one",
      "status": "experimental",
      "since": "9.8",
      "enforcement": "text-only",
      "rule": "Read the handover first.",
      "ratchet": "Text only: reading is not visible",
      "source": ""
    },
    {
      "key": "ratchet.changed-unadopted",
      "part": "one",
      "principle": "principle.one",
      "status": "experimental",
      "since": "9.8",
      "enforcement": "text-only",
      "rule": "Ask the owner before you merge.",
      "ratchet": "Text only: asking is a judgment",
      "source": ""
    },
    {
      "key": "ratchet.added",
      "part": "one",
      "principle": "principle.one",
      "status": "experimental",
      "since": "9.9",
      "enforcement": "enforced",
      "rule": "The main branch takes changes only through PRs.",
      "ratchet": "Check: branch protection with required checks",
      "source": ""
    },
    {
      "key": "ratchet.added-text",
      "part": "one",
      "principle": "principle.one",
      "status": "experimental",
      "since": "9.9",
      "enforcement": "text-only",
      "rule": "Keep four kinds of statement apart.",
      "ratchet": "Text only: a check cannot tell a proposal from a decision",
      "source": ""
    }
  ],
  "experimental_cap": 10
}
